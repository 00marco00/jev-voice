# Full-local: no API key needed. Local Laya checkpoint (MLX, Apple Silicon).
LAYA_MODEL=aac6fef/laya-mlx
# Max options per choice question before fuzzy shortlisting (Laya collapses past ~20;
# 10 measures better on the voice schema: correct argmax, lower latency).
LAYA_MAX_OPTIONS=10

# Feedback after an action: ding (chime) | voice (spoken butler)
FEEDBACK=ding
# PERSONA=alfred (posh UK butler) | cowboy | plain ; USER_NAME is used in "master <name>"
PERSONA=alfred
USER_NAME=Wayne

# Optional better voice (ElevenLabs Flash, cached to disk). Defaults: alfred=George, cowboy=Bill
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

# Hands-free: names that address the assistant; follow-up window after a command (seconds)
WAKE_WORDS=alfred,jarvis,alfie,alford,elfred
FOLLOWUP_SECONDS=8
# Unnamed utterances: 1 = let Laya judge if it's a command; gates 0..1 (0 = never ignore)
UNNAMED_COMMANDS=1
UNNAMED_MIN_ADDRESSED=0
UNNAMED_MIN_CONFIDENCE=0

# OVERLAY=0 to hide the floating transcription pill
OVERLAY=1
